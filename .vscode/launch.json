{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "xmake Debug Generator",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/windows/x64/debug/generator.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "PATH",
          "value": "${env:PATH};${workspaceFolder}/third_party/bin;${workspaceFolder}/build/windows/x64/debug"
        }
      ],
      "console": "externalTerminal",
      "preLaunchTask": "xmake build generator"
    },
    {
      "name": "xmake Debug Generator (EF)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/windows/x64/debug/generator.exe",
      "args": [
        "-t",
        "1",
        "-o",
        "EFResults_debug"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "externalTerminal",
      "preLaunchTask": "xmake build generator"
    },
    {
      "name": "xmake Debug Generator (EE)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/windows/x64/debug/generator.exe",
      "args": [
        "-t",
        "2",
        "-o",
        "EEResults_debug"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "externalTerminal",
      "preLaunchTask": "xmake build generator"
    },
    {
      "name": "xmake Debug Generator (FF)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/windows/x64/debug/generator.exe",
      "args": [
        "-t",
        "0",
        "-o",
        "FFResults_debug"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "externalTerminal",
      "preLaunchTask": "xmake build generator"
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "e:/research/simulation/datagen/generator",
      "program": "e:/research/simulation/datagen/generator/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}